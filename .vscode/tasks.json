{
  "version": "2.0.0",
  //список задач
  "tasks": [
    {
      "label": "build debug",
      "type": "shell",
      "command": "gfortran",
      "args": [
        "-Wall", //	Вывод сообщений о всех предупреждениях или ошибках, возникающих во время компиляции программы
        "-g", //Поместить в объектный или исполняемый файл отладочную информацию для отладчика gdb. Опция должна быть указана и для компиляции, и для компоновки.
        "-O0", // В сочетании –g рекомендуется использовать опцию отключения оптимизации –O0
        "src\\*.f90", // компилируюся все файлы *.f90 из папки src //можно прописать все файлы отдельно: "src\\modules.f90", "src\\main.f90", "src\\FileName.f90",
        //"src\\modules.f90", "src\\main.f90", "src\\FileName.f90",
        "-o", // создание файлов *.o
        "${workspaceFolder}\\s01.exe" //имя исполняемого файла //"${workspaceRoot}\\${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}